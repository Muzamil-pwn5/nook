# Optional for a real deployment. When unset, the API uses a seeded in-memory SQLite demo database.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/agentic_commerce

# Provider-neutral LLM configuration.
# Use groq, openai, or gemini in a real deployment. `mock` is for tests only.
LLM_PROVIDER=groq

# Groq uses its OpenAI-compatible API. Keep this value only in backend/.env.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
